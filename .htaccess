Options -Indexes
DirectoryIndex index.html

RewriteEngine On

# Serve index.html for clean directory URLs
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_FILENAME}/index.html -f
RewriteRule ^(.*)$ $1/index.html [L]

# Remove .html extension from direct .html requests (redirect to clean URL)
RewriteCond %{THE_REQUEST} /([^.]+)\.html[\s?]
RewriteRule ^ /%1/ [R=301,L]

# Internally rewrite clean URLs to .html files
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Cache headers para assets
<FilesMatch "\.(mp4|webp|jpg|jpeg|png|gif|otf|ttf|woff|woff2)$">
  Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
<FilesMatch "\.html$">
  Header set Cache-Control "public, max-age=0, must-revalidate"
</FilesMatch>
